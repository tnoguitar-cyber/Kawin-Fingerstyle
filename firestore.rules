rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Site statistics counter (global document only)
    match /site_stats/{docId} {
      allow read: if true;
      allow create, update: if docId == 'global'
        && request.resource.data.totalViews is number
        && request.resource.data.todayViews is number
        && request.resource.data.lastUpdatedDate is string;
      allow delete: if false;
    }

    // Active presence tracking (per session)
    match /active_presence/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.sessionId is string
        && request.resource.data.lastSeen is number;
      allow delete: if true;
    }
  }
}

